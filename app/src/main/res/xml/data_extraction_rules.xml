<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+ (android:dataExtractionRules).
   Exclude all vault databases, key envelopes, and settings files
   from both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="file"
            path="." />
    </device-transfer>
</data-extraction-rules>
